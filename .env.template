# API keys (comma-separated values enable round-robin rotation per provider + tier)
# Copy this file to `.env` and fill in the keys for the providers/tiers you use.

# Local OpenAI-compatible server (optional; falls back to `default_api_key` in config.toml if empty)
LOCAL_OPENAI_API_KEYS=

# Google Gemini
GEMINI_FREE_API_KEYS=your-gemini-free-key-1,your-gemini-free-key-2
GEMINI_PAID_API_KEYS=

# OpenRouter
OPENROUTER_FREE_API_KEYS=
OPENROUTER_PAID_API_KEYS=

# Optional custom path to TOML configuration file
# LOM_CONFIG_FILE=config.toml
